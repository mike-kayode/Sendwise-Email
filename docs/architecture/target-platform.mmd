flowchart TB
    User[Customer browser / API client] --> Edge[TLS edge proxy]
    Edge --> Gateway[API Gateway]
    Gateway --> IAM[Identity]
    Gateway --> Org[Workspace]
    Gateway --> Audience[Audience]
    Gateway --> Consent[Consent and Compliance]
    Gateway --> Campaign[Campaign Management]
    Gateway --> Design[Template and Design]
    Gateway --> Domain[Domain and Deliverability]
    Gateway --> Forms[Forms]
    Gateway --> Billing[Billing and Entitlements]
    Gateway --> Automation[Automation]
    Gateway --> Analytics[Tracking and Analytics]
    Gateway --> Integrations[Integrations and Webhooks]
    Gateway --> Admin[Platform Admin]

    IAM --> E[(NATS JetStream)]
    Org --> E
    Audience --> E
    Consent --> E
    Campaign --> E
    Design --> E
    Domain --> E
    Forms --> E
    Billing --> E
    Automation --> E
    E --> Delivery[Delivery Orchestration]
    Delivery --> E
    E --> Workers[Independent Delivery Workers]
    Workers --> Transport[SMTP Transport Service]
    Transport --> Stalwart[Stalwart SMTP cluster]
    Stalwart --> Internet[Recipient mail systems]
    Internet --> Bounce[Bounce and Complaint Processing]
    Bounce --> E
    E --> Analytics
    E --> Automation
    E --> Integrations
    E --> Notification[Notification Service]
    Notification --> TransactionalSMTP[Transactional SMTP transport]

    subgraph Isolated["Service-owned Postgres data and credentials"]
        D1[(Identity)]
