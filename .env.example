APP_ENV=development
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
TRACKING_BASE_URL=http://localhost:8080
SITE_ADDRESS=:80

# Service-to-service authentication (required in production).
# Generate with: openssl rand -hex 32
SERVICE_TOKEN=

# PostgreSQL (shared legacy database and service-owned databases).
POSTGRES_USER=email
POSTGRES_PASSWORD=
POSTGRES_DB=email
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=
WORKSPACE_DB_USER=workspace_app
WORKSPACE_DB_PASSWORD=

# NATS JetStream
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (required).
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=email-platform
ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h

# SMTP (Stalwart or compatible relay).
SMTP_ADDR=localhost:587
SMTP_HOST=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pipsleague.com

# Webhook signing secret (required for bounce/complaint webhook verification).
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Resend (optional fallback for transactional mail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pipsleague.com
RESEND_FROM_NAME=Sendwise

# Migration settings.
MIGRATIONS_DIR=./migrations
AUTO_MIGRATE=true

# Delivery controls.
DKIM_SELECTOR=mail
WORKER_METRICS_ADDR=:9091
SENDING_RATE_PER_SECOND=20
MAX_DELIVERY_ATTEMPTS=5
SCHEDULER_INTERVAL=15s
MAX_MESSAGE_AGE=48h
MAX_DAILY_EMAILS=10000
MAX_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.001
DOMAIN_CONCURRENCY_LIMIT=10

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000
REQUIRE_VERIFIED_DOMAIN=false

# Gateway upstreams.
IDENTITY_URL=http://localhost:8081
WORKSPACE_URL=http://localhost:8082
LEGACY_API_URL=http://localhost:8090

# Frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:3000
