# ---------------------------------------------------------------------------
# Sendwise environment template.
# Copy to .env and fill in every blank required value. Never commit .env.
# Local-only value overrides belong in .env.local (gitignored; keys must also
# be declared in .env).
# Every variable read by the application or compose files is listed here.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
# Public origins. In production these MUST be the real public URL of the
# deployment (https://campaign.pipsleague.com) — never http://localhost:8080.
# scripts/check-env.sh fails a production/staging run that still points at
# localhost. Local development overrides live in .env.local.
APP_BASE_URL=https://campaign.pipsleague.com
API_BASE_URL=https://campaign.pipsleague.com
TRACKING_BASE_URL=https://campaign.pipsleague.com
SITE_ADDRESS=:80

# Service-to-service authentication (required in production; required by the
# gateway fail-fast check and by scripts/check-env.sh). Generate with:
# openssl rand -hex 32
SERVICE_TOKEN=

# PostgreSQL (shared legacy database and service-owned databases).
POSTGRES_USER=email
POSTGRES_PASSWORD=
POSTGRES_DB=email
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=
WORKSPACE_DB_USER=workspace_app
WORKSPACE_DB_PASSWORD=
# Per-service DATABASE_URL values are composed by docker-compose from the
# POSTGRES_*/IDENTITY_DB_*/WORKSPACE_DB_* variables above; set them directly
# only when running services outside compose.

# For `go run ./cmd/backfill`, set the source and legacy database DSNs:
IDENTITY_DATABASE_URL=
WORKSPACE_DATABASE_URL=
LEGACY_DATABASE_URL=

# NATS JetStream
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (required).
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=email-platform
ACCESS_TOKEN_TTL=15m
# Optional per-service overrides:
IDENTITY_ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h
WORKSPACE_INVITATION_TTL=168h
# Force Secure refresh cookies outside production (production is always Secure).
COOKIE_SECURE=false

# Mail provider for Identity verification, password reset, and workspace
# invitation email: auto|resend|smtp|log.
# Local development can use Mailpit via SMTP. Production must use SMTP with
# SMTP_ADDR, SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM, or Resend with
# RESEND_API_KEY and RESEND_FROM_EMAIL. The log provider is development-only.
MAIL_PROVIDER=auto

# SMTP (Mailpit in local dev; Stalwart or another relay in production).
# scripts/check-env.sh refuses a production/staging SMTP target of mailpit,
# localhost, 127.0.0.1, ::1 or 0.0.0.0: campaign delivery always uses SMTP,
# so these must point at a real relay even when transactional mail uses Resend.
# Compose DNS name for container-to-container mail. Host-run services can use
# localhost:1025 and localhost instead.
SMTP_ADDR=mailpit:1025
SMTP_HOST=mailpit
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pipsleague.com

# Local Stalwart provisioning only; never use these values for a production
# server. Set passwords in the shell/secret store rather than committing them.
STALWART_URL=http://127.0.0.1:8081
STALWART_DOMAIN=
STALWART_HOSTNAME=
STALWART_ADMIN_USERNAME=
STALWART_ADMIN_PASSWORD=
STALWART_SUBMIT_USERNAME=noreply
STALWART_SUBMIT_PASSWORD=

# Webhook signing secret (required for bounce/complaint webhook verification).
# Generate with: openssl rand -hex 32
# The stack will NOT start without it: compose reads
# ${WEBHOOK_SECRET:?Set WEBHOOK_SECRET in .env} for api and worker and refuses
# to start when this is unset or empty (APP_ENV=staging/production).
WEBHOOK_SECRET=

# Resend (optional fallback for transactional mail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pipsleague.com
RESEND_FROM_NAME=Sendwise

# Migration settings.
MIGRATIONS_DIR=./migrations
AUTO_MIGRATE=true

# Delivery controls.
DKIM_SELECTOR=mail
# Generate with: openssl rand -hex 32. Required to create sending domains;
# encrypts each generated DKIM private key at rest.
DKIM_ENCRYPTION_KEY=
# Optional SPF include hostname. If empty, records use the mx mechanism.
SPF_INCLUDE=
DNS_RESOLVER_ADDR=
DNS_RESOLVER_TIMEOUT=2s
WORKER_METRICS_ADDR=:9091
SENDING_RATE_PER_SECOND=20
MAX_DELIVERY_ATTEMPTS=5
SCHEDULER_INTERVAL=15s
MAX_MESSAGE_AGE=48h
MAX_DAILY_EMAILS=10000
WARMUP_START_PER_DAY=50
WARMUP_GROWTH_FACTOR=1.5
MAX_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.001
DOMAIN_CONCURRENCY_LIMIT=10
# Comma-separated recipient-domain messages/second. Include default.
RECIPIENT_DOMAIN_RATE_LIMITS=default=10,gmail.com=5,yahoo.com=5,outlook.com=5
# Comma-separated admin emails for internal admin endpoints.
SUPER_ADMIN_EMAILS=

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000
REQUIRE_VERIFIED_DOMAIN=false

# Identity/workspace/gateway upstreams for services run outside Compose.
# Compose uses service DNS for container-to-container calls.
IDENTITY_URL=http://localhost:8082
WORKSPACE_URL=http://workspace:8080
LEGACY_API_URL=http://localhost:8080
GATEWAY_AUTH_RATE_PER_MINUTE=60
GATEWAY_AUTH_BURST=20

# Verified account used only by the deploy script's read-only API smoke tests.
# Use a dedicated account with access to the default organization.
DEPLOY_SMOKE_EMAIL=
DEPLOY_SMOKE_PASSWORD=

# Frontend (build-time + runtime). Derived from API_BASE_URL by compose; the
# browser uses it as the API origin, so production needs the public URL here.
NEXT_PUBLIC_API_URL=https://campaign.pipsleague.com

# --- Compose profiles -------------------------------------------------------
# MinIO (profile "storage"; unused by application code today).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Observability profile (Prometheus/Grafana/Loki).
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Development/test only (never set in production) -------------------------
# Identity dev seed (guarded by APP_ENV=development):
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
# DEV_SEED_NAME=
# DEV_SEED_ORGANIZATION=
# Integration tests (host paths, not container paths):
# TEST_DATABASE_URL=postgres://email:email@localhost:5432/email_test?sslmode=disable
# INTEGRATION_DATABASE_URL=postgres://email:email@localhost:5432/email_integration?sslmode=disable
