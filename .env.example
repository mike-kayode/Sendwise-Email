# ---------------------------------------------------------------------------
# Sendwise environment template.
# Copy to .env and fill in every blank required value. Never commit .env.
# Local-only value overrides belong in .env.local (gitignored; keys must also
# be declared in .env).
# Every variable read by the application or compose files is listed here.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
# Public origins. In production these MUST be the real public URL of the
# deployment (https://campaign.pipsleague.com) — never http://localhost:8080.
# scripts/check-env.sh fails a production/staging run that still points at
# localhost. Local development overrides live in .env.local.
APP_BASE_URL=https://campaign.pipsleague.com
API_BASE_URL=https://campaign.pipsleague.com
TRACKING_BASE_URL=https://campaign.pipsleague.com
SITE_ADDRESS=:80

# Service-to-service authentication (required in production; required by the
# gateway fail-fast check and by scripts/check-env.sh). Generate with:
# openssl rand -hex 32
SERVICE_TOKEN=

# PostgreSQL (shared legacy database and service-owned databases).
POSTGRES_USER=email
POSTGRES_PASSWORD=
POSTGRES_DB=email
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=
WORKSPACE_DB_USER=workspace_app
WORKSPACE_DB_PASSWORD=
# Per-service DATABASE_URL values are composed by docker-compose from the
# POSTGRES_*/IDENTITY_DB_*/WORKSPACE_DB_* variables above; set them directly
# only when running services outside compose.

# For `go run ./cmd/backfill`, set the source and legacy database DSNs:
IDENTITY_DATABASE_URL=
WORKSPACE_DATABASE_URL=
LEGACY_DATABASE_URL=

# NATS JetStream
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (required).
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=email-platform
ACCESS_TOKEN_TTL=15m
# Optional per-service overrides:
IDENTITY_ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h
# Optional CIDR/IP allowlist for all platform-admin API requests. Empty allows
# access from any IP, while platform role and MFA checks remain mandatory.
ADMIN_IP_ALLOWLIST=
WORKSPACE_INVITATION_TTL=168h
# Force Secure refresh cookies outside production (production is always Secure).
COOKIE_SECURE=false

# Platform transactional mail provider: auto|smtp|log.
# SMTP_ADDR/SMTP_HOST below are campaign settings and are never used by the
# production Identity service. Configure the dedicated platform relay below.
MAIL_PROVIDER=auto

# Campaign SMTP. Local development uses Mailpit. When the campaign worker runs
# in Docker in production, SMTP_ADDR must use the internal service address
# stalwart:587 (not the server's public IP); the optional host-network override
# changes that to host.docker.internal:587. SMTP_HOST remains the public
# hostname on the relay's TLS certificate.
# scripts/check-env.sh refuses a production/staging SMTP target of mailpit,
# localhost, 127.0.0.1, ::1 or 0.0.0.0: campaign delivery always uses SMTP,
# so these must point at a real relay. Compose DNS name for
# container-to-container mail. Host-run services can use localhost:1025 and
# localhost instead.
SMTP_ADDR=mailpit:1025
SMTP_HOST=mailpit
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pipsleague.com
# Domain that receives VERP-addressed DSNs/ARF feedback.
BOUNCE_DOMAIN=bounces.pipsleague.com

# Transactional SMTP submission (disabled by default). Compose publishes
# alternate local ports because Stalwart already uses host ports 465/587.
TRANSACTIONAL_ENABLED=false
TRANSACTIONAL_SMTP_ENABLED=false
TRANSACTIONAL_SMTP_HOSTNAME=
TRANSACTIONAL_SMTP_BIND_ADDRESS=0.0.0.0
TRANSACTIONAL_SMTP_STARTTLS_ADDR=0.0.0.0:2587
TRANSACTIONAL_SMTP_IMPLICIT_TLS_ADDR=0.0.0.0:2465
TRANSACTIONAL_SMTP_TLS_CERT=/run/sendwise/smtp-certs/fullchain.pem
TRANSACTIONAL_SMTP_TLS_KEY=/run/sendwise/smtp-certs/privkey.pem
TRANSACTIONAL_SMTP_HOST_BIND_ADDRESS=127.0.0.1
TRANSACTIONAL_SMTP_STARTTLS_HOST_PORT=2587
TRANSACTIONAL_SMTP_IMPLICIT_TLS_HOST_PORT=2465

# Stalwart management/provisioning. STALWART_URL is the host-side provisioner
# endpoint; STALWART_MANAGEMENT_URL is the API-to-Stalwart endpoint (the
# host-network override routes it through the private host-gateway proxy). The
# optional host-network Compose override is Linux-server-only; enable it with
# STALWART_HOST_NETWORK=true and verify DOCKER_HOST_GATEWAY_IP on that host.
# Keep passwords in a secret store, never commit them.
STALWART_HOST_NETWORK=false
DOCKER_HOST_GATEWAY_IP=172.17.0.1
STALWART_URL=http://127.0.0.1:8081
STALWART_MANAGEMENT_URL=http://stalwart:8080
STALWART_DOMAIN=
STALWART_HOSTNAME=
STALWART_ADMIN_USERNAME=admin
STALWART_ADMIN_PASSWORD=
STALWART_SUBMIT_USERNAME=noreply
STALWART_SUBMIT_PASSWORD=
STALWART_BIND_ADDRESS=127.0.0.1
STALWART_CERTS_DIR=./secrets/stalwart/certs
STALWART_PORT_25=25
STALWART_PORT_465=465
STALWART_PORT_587=587
STALWART_ADMIN_PORT=8081

# Webhook signing secret (required for bounce/complaint webhook verification).
# Generate with: openssl rand -hex 32
# The stack will NOT start without it: compose reads
# ${WEBHOOK_SECRET:?Set WEBHOOK_SECRET in .env} for api and worker and refuses
# to start when this is unset or empty (APP_ENV=staging/production).
WEBHOOK_SECRET=

# Platform transactional mail (verification, password reset, invitations).
# Set a verified sender domain and dedicated relay. In production the
# Identity service never falls back to campaign SMTP or Stalwart.
PLATFORM_FROM_EMAIL=hello@pipsleague.com
PLATFORM_VERIFIED_SENDER_DOMAINS=
PLATFORM_SMTP_ADDR=
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_TLS_MODE=starttls
PLATFORM_SMTP_USERNAME=
PLATFORM_SMTP_PASSWORD=
PLATFORM_MAIL_API_KEY=
# Leave empty to store contact form submissions without sending notifications.
CONTACT_NOTIFY_EMAIL=

# Migration settings.
MIGRATIONS_DIR=./migrations
AUTO_MIGRATE=false

# Delivery controls.
DKIM_SELECTOR=mail
# Generate with: openssl rand -hex 32. Required to create sending domains;
# encrypts each generated DKIM private key at rest.
DKIM_ENCRYPTION_KEY=
# SPF include hostname for campaign domains (normally the platform domain,
# whose SPF record authorizes Stalwart). If empty, records use the mx mechanism,
# which is only appropriate when the sending domain's MX points to Stalwart.
SPF_INCLUDE=
# Optional recursive resolver for sending-domain DNS verification. When set it
# replaces the default public resolvers (1.1.1.1 and 8.8.8.8) and is also used
# to discover authoritative nameservers. Accepts host or host:port form.
DNS_RESOLVER_ADDR=
# Per-query timeout for DNS verification lookups.
DNS_RESOLVER_TIMEOUT=2s
WORKER_METRICS_ADDR=:9091
# These limits seed platform_quota_defaults on first startup only.
SENDING_RATE_PER_SECOND=20
# Emergency per-domain sending-rate ceiling. Domain quota overrides cannot exceed it.
PLATFORM_MAX_DOMAIN_RATE=1000
SMTP_POOL_SIZE=10
MAX_DELIVERY_ATTEMPTS=5
SCHEDULER_INTERVAL=15s
MAX_MESSAGE_AGE=48h
NATS_STALE_PUBLISH_TIMEOUT=10m
# Stalwart queue reconciliation is rate-limited by polling a bounded batch each interval.
DELIVERY_JOURNEY_RECONCILE_INTERVAL=1m
DELIVERY_JOURNEY_RECONCILE_BATCH=100
# Alert when a submitted or relaying recipient has no Stalwart event for this long.
DELIVERY_JOURNEY_STUCK_AFTER=30m
# Optional comma-separated legacy bounce domains. Reconciler matches jobs whose
# VERP return path used an old BOUNCE_DOMAIN (for example after domain rotation).
DELIVERY_JOURNEY_LEGACY_BOUNCE_DOMAINS=
# Outbound SMTP egress health probe (TCP port 25). The probe runs in Stalwart's
# network namespace so it measures Stalwart's own outbound path, not the worker's.
# When blocked, new campaign sends are paused automatically and resume when
# connectivity recovers. Set DELIVERY_EGRESS_GATE_ENABLED=false to keep reporting
# status on the dashboard without pausing sends.
DELIVERY_EGRESS_GATE_ENABLED=true
DELIVERY_EGRESS_CHECK_INTERVAL=5m
DELIVERY_EGRESS_CHECK_TIMEOUT=5s
DELIVERY_EGRESS_CHECK_HOSTS=gmail-smtp-in.l.google.com:25,outlook-com.olc.protection.outlook.com:25,mta5.am0.yahoodns.net:25
# Initial marketing quota seed; warm-up still uses the warm-up settings below.
MAX_DAILY_EMAILS=10000
WARMUP_START_PER_DAY=50
WARMUP_GROWTH_FACTOR=1.5
MAX_BOUNCE_RATE=0.02
MAX_COMPLAINT_RATE=0.0005
DOMAIN_CONCURRENCY_LIMIT=10
# Comma-separated recipient-domain messages/second. Include default.
RECIPIENT_DOMAIN_RATE_LIMITS=default=10,gmail.com=5,yahoo.com=5,outlook.com=5

# Customer transactional email is separately gated and does not change the
# existing platform verification/reset mail path. Defaults keep it disabled.
TRANSACTIONAL_ENABLED=false
TRANSACTIONAL_SMTP_ENABLED=false
TRANSACTIONAL_SMTP_HOSTNAME=
TRANSACTIONAL_SMTP_BIND_ADDRESS=0.0.0.0
TRANSACTIONAL_MAX_RETRY_HOURS=24
# Initial transactional quota seeds; subsequent edits are stored in the database.
TRANSACTIONAL_REQUESTS_PER_SECOND=5
TRANSACTIONAL_DAILY_LIMIT=1000
TRANSACTIONAL_MONTHLY_LIMIT=10000
TRANSACTIONAL_MAX_RECIPIENTS=10
TRANSACTIONAL_MAX_MESSAGE_BYTES=10485760
TRANSACTIONAL_WORKER_CONCURRENCY=4
TRANSACTIONAL_SMTP_POOL_SIZE=4
TRANSACTIONAL_MAX_BOUNCE_RATE=0.05
TRANSACTIONAL_MAX_COMPLAINT_RATE=0.003
TRANSACTIONAL_MINIMUM_SAMPLE_SIZE=100
# Comma-separated admin emails for internal admin endpoints.
SUPER_ADMIN_EMAILS=

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000
REQUIRE_VERIFIED_DOMAIN=false

# Identity/workspace/gateway upstreams for services run outside Compose.
# Compose uses service DNS for container-to-container calls.
IDENTITY_URL=http://localhost:8082
WORKSPACE_URL=http://workspace:8080
LEGACY_API_URL=http://localhost:8080
GATEWAY_AUTH_RATE_PER_MINUTE=60
GATEWAY_AUTH_BURST=20

# Verified account used only by the deploy script's read-only API smoke tests.
# Use a dedicated account with access to the default organization.
DEPLOY_SMOKE_EMAIL=
DEPLOY_SMOKE_PASSWORD=

# Frontend (build-time + runtime). Derived from API_BASE_URL by compose; the
# browser uses it as the API origin, so production needs the public URL here.
NEXT_PUBLIC_API_URL=https://campaign.pipsleague.com
NEXT_PUBLIC_SITE_URL=https://campaign.pipsleague.com

# --- Compose profiles -------------------------------------------------------
# MinIO (profile "storage"; unused by application code today).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Observability profile (Prometheus/Grafana/Loki).
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Development/test only (never set in production) -------------------------
# Identity dev seed (guarded by APP_ENV=development):
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
# DEV_SEED_NAME=
# DEV_SEED_ORGANIZATION=
# Integration tests (host paths, not container paths):
# TEST_DATABASE_URL=postgres://email:email@localhost:5432/email_test?sslmode=disable
# INTEGRATION_DATABASE_URL=postgres://email:email@localhost:5432/email_integration?sslmode=disable
