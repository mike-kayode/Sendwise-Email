# ---------------------------------------------------------------------------
# Sendwise environment template.
# Copy to .env and fill in every blank required value. Never commit .env.
# Local-only overrides belong in .env.local (gitignored; merged after .env).
# Every variable read by the application or compose files is listed here.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
TRACKING_BASE_URL=http://localhost:8080
SITE_ADDRESS=:80

# Service-to-service authentication (required in production; required by the
# gateway fail-fast check). Generate with: openssl rand -hex 32
SERVICE_TOKEN=

# PostgreSQL (shared legacy database and service-owned databases).
POSTGRES_USER=email
POSTGRES_PASSWORD=
POSTGRES_DB=email
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=
WORKSPACE_DB_USER=workspace_app
WORKSPACE_DB_PASSWORD=
# Per-service DATABASE_URL values are composed by docker-compose from the
# POSTGRES_*/IDENTITY_DB_*/WORKSPACE_DB_* variables above; set them directly
# only when running services outside compose.

# NATS JetStream
NATS_URL=nats://localhost:4222

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (required).
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=email-platform
ACCESS_TOKEN_TTL=15m
# Optional per-service overrides:
IDENTITY_ACCESS_TOKEN_TTL=15m
IDENTITY_REFRESH_TOKEN_TTL=168h
WORKSPACE_INVITATION_TTL=168h
# Force Secure refresh cookies outside production (production is always Secure).
COOKIE_SECURE=false

# Mail provider for Identity verification/reset: auto|resend|smtp
# (log is development-only and prints the message link; never use in production).
MAIL_PROVIDER=auto

# SMTP (Stalwart or compatible relay).
SMTP_ADDR=localhost:587
SMTP_HOST=localhost
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pipsleague.com

# Webhook signing secret (required for bounce/complaint webhook verification).
# Generate with: openssl rand -hex 32
# The stack will NOT start without it: compose reads
# ${WEBHOOK_SECRET:?Set WEBHOOK_SECRET in .env} for api and worker and refuses
# to start when this is unset or empty (APP_ENV=staging/production).
WEBHOOK_SECRET=

# Resend (optional fallback for transactional mail).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@pipsleague.com
RESEND_FROM_NAME=Sendwise

# Migration settings.
MIGRATIONS_DIR=./migrations
AUTO_MIGRATE=true

# Delivery controls.
DKIM_SELECTOR=mail
WORKER_METRICS_ADDR=:9091
SENDING_RATE_PER_SECOND=20
MAX_DELIVERY_ATTEMPTS=5
SCHEDULER_INTERVAL=15s
MAX_MESSAGE_AGE=48h
MAX_DAILY_EMAILS=10000
MAX_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.001
DOMAIN_CONCURRENCY_LIMIT=10
# Comma-separated admin emails for internal admin endpoints.
SUPER_ADMIN_EMAILS=

# CORS
CORS_ORIGINS=http://localhost,http://localhost:3000
REQUIRE_VERIFIED_DOMAIN=false

# Gateway upstreams (required in production; gateway fails fast if missing).
# Host-port defaults below match the compose port mappings.
IDENTITY_URL=http://localhost:8082
WORKSPACE_URL=http://localhost:8083
LEGACY_API_URL=http://localhost:8080
GATEWAY_AUTH_RATE_PER_MINUTE=60
GATEWAY_AUTH_BURST=20

# Frontend (build-time + runtime).
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Compose profiles -------------------------------------------------------
# MinIO (profile "storage"; unused by application code today).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Observability profile (Prometheus/Grafana/Loki).
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Development/test only (never set in production) -------------------------
# Identity dev seed (guarded by APP_ENV=development):
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
# DEV_SEED_NAME=
# DEV_SEED_ORGANIZATION=
# Integration tests (host paths, not container paths):
# TEST_DATABASE_URL=postgres://email:email@localhost:5432/email_test?sslmode=disable
# INTEGRATION_DATABASE_URL=postgres://email:email@localhost:5432/email_integration?sslmode=disable
